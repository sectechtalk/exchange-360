# Build defaults. Fill in your own tenant and app ids. Copy to .env (Start-Ex360.ps1 does this once).
# They are identifiers, not secrets:
# the app registration has no client secret.
# Every one-off setting this file and the app registration need is checked live on
# Setup steps: http://localhost:8360/#setup . The written list is docs/setup.md.
PORT=8360
HOST=127.0.0.1
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
# Object id of the Ex360 app registration. The server does not send this to Microsoft.
ENTRA_OBJECT_ID=your-object-id
# Initial domain. Used only when the signed-in UPN is unknown (Connect-ExchangeOnline -Organization).
ENTRA_ORGANIZATION=example.onmicrosoft.com
# Register this URI under Mobile and desktop applications (public client), not Web.
# A Web redirect returns AADSTS7000218 because Ex360 sends no client secret.
ENTRA_REDIRECT_URI=http://localhost:8360/auth/callback
# Delegated Graph scopes (one token). Exchange is a second token; see docs/auth.md.
# .default asks for the Office 365 Exchange Online permissions already on the app (Exchange.Manage).
# Do not set this to Exchange.Manage. Entra looks that name up on Microsoft Graph and returns AADSTS650053.
GRAPH_SCOPES=openid profile offline_access User.Read User.Read.All Directory.Read.All Organization.Read.All Domain.Read.All Policy.Read.All AuditLog.Read.All Reports.Read.All ServiceHealth.Read.All ServiceMessage.Read.All SecurityEvents.Read.All Mail.Read Mail.Read.Shared MailboxSettings.Read RoleManagement.Read.Directory
EXO_SCOPE=https://outlook.office365.com/.default
# Public client. Do not set a client secret.
# EX360_DEMO=1 forces Contoso demo data even when a session exists.
# Optional: store config snapshots in a snapshot store you run (docs/snapshots.md).
# Leave them empty and snapshots are saved on this PC in %USERPROFILE%\Ex360-snapshots.
# SNAPSHOT_STORE_URL=https://<store address>   (a store on this PC: http://host.docker.internal:<port>)
# SNAPSHOT_STORE_API_SCOPE=api://<store API app id>/Snapshots.ReadWrite
